<?xml version="1.0" encoding="utf-8" ?>
<!-- Fila de texto para MarkupList: título, subtítulo opcional y texto a la derecha. Foco rosa. -->
<component name="TextItem" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContent" />
        <field id="width" type="float" onChange="onLayout" />
        <field id="height" type="float" onChange="onLayout" />
        <field id="index" type="integer" />
        <field id="rowIndex" type="integer" />
        <field id="rowHasFocus" type="boolean" />
        <field id="rowListHasFocus" type="boolean" />
        <field id="gridHasFocus" type="boolean" />
        <field id="listHasFocus" type="boolean" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
        <field id="focusPercent" type="float" />
        <field id="rowFocusPercent" type="float" />
    </interface>
    <children>
        <Rectangle id="bg" color="0x1A1A2EFF" />
        <Label id="title" font="font:MediumBoldSystemFont" color="0xF3F4F6FF" />
        <Label id="line2" font="font:SmallSystemFont" color="0xB4B4C8FF" />
        <Label id="right" font="font:SmallBoldSystemFont" horizAlign="right" vertAlign="center" wrap="true" />
    </children>
    <script type="text/brs" uri="TextItem.brs" />
</component>
