<?xml version="1.0" encoding="utf-8" ?>
<!-- Mi lista: títulos guardados por el usuario. -->
<component name="MyListScreen" extends="Group">
    <interface>
        <field id="action" type="assocarray" alwaysNotify="true" />
        <function name="activate" />
    </interface>
    <children>
        <ButtonBar id="nav" translation="[80,36]" itemWidth="190" barHeight="56" />
        <Label id="title" translation="[80,130]" width="1200" height="60" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <MarkupGrid id="grid" translation="[80,220]" itemComponentName="PosterItem" numColumns="7" numRows="2"
            itemSize="[220,330]" itemSpacing="[34,40]" drawFocusFeedback="false" focusBitmapUri="pkg:/images/transparent.png" />
        <Label id="status" translation="[0,420]" width="1920" height="200" font="font:MediumSystemFont" color="0xE5E7EBFF" horizAlign="center" wrap="true" />
        <Label id="focusTitle" translation="[80,960]" width="1500" height="40" font="font:MediumBoldSystemFont" color="0xE5E7EBFF" />
        <Label id="hint" translation="[80,1010]" width="1700" height="36" font="font:SmallestSystemFont" color="0x9CA3AFFF" />
    </children>
    <script type="text/brs" uri="MyListScreen.brs" />
    <script type="text/brs" uri="pkg:/components/lib/Util.brs" />
    <script type="text/brs" uri="pkg:/components/lib/Strings.brs" />
    <script type="text/brs" uri="pkg:/components/lib/Plugins.brs" />
    <script type="text/brs" uri="pkg:/components/lib/Language.brs" />
    <script type="text/brs" uri="pkg:/components/lib/Streams.brs" />
    <script type="text/brs" uri="pkg:/components/lib/Settings.brs" />
    <script type="text/brs" uri="pkg:/components/lib/Ui.brs" />
</component>
